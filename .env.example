# Copy this file to .env for local dev. Never commit .env.
# In production (Render, etc.), set these in the hosting provider's dashboard.

NODE_ENV=development

# Email — pickup requests are emailed via Resend (https://resend.com).
# Without RESEND_API_KEY, requests are still saved to the DB but no email is sent.
RESEND_API_KEY=
EMAIL_TO=thelastmilebooks@gmail.com,haylee@lastmilebooks.com
EMAIL_FROM=pickups@lastmilebooks.com
# Customer replies go here (EMAIL_FROM has no inbox, so replies to it bounce).
EMAIL_REPLY_TO=thelastmilebooks@gmail.com,haylee@lastmilebooks.com

# SQLite file. On Render this must be on the persistent disk (see render.yaml).
DATABASE_PATH=data.db

# Protects /api/pickup-requests and the inventory admin page (/#/inventory).
ADMIN_KEY=

# --- Inventory sync (Whatnot + eBay) ---
# Whatnot personal access token: whatnot.com/dashboard/developer → Personal access tokens.
# Scopes: read:orders, read:inventory, write:inventory.
WHATNOT_API_TOKEN=
# Optional, for instant sales via webhook (developer dashboard → app → webhook URL
# https://<your site>/api/webhooks/whatnot, topics orders.created + orders.updated).
WHATNOT_WEBHOOK_SECRET=
# eBay: developer.ebay.com → Application Keys (Production) and User Tokens → RuName.
# Set the RuName's "auth accepted URL" to https://<your site>/api/inventory/ebay/callback
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_RU_NAME=
# How often to check both marketplaces for new orders.
INVENTORY_POLL_SECONDS=60
